{
  "name": "release-please-projected-releases-action",
  "version": "0.6.0",
  "description": "Say on a pull request which release-please tags merging it will cut.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run ${VITEST_COVER:-}",
    "check": "npm run typecheck && npm run build && npm run test",
    "check:infra": "cd infra/github && tofu fmt -check -recursive . && tofu init -backend=false && tofu validate",
    "cover": "VITEST_COVER=--coverage npm run check"
  },
  "dependencies": {
    "release-please": "17.11.2",
    "yaml": "^2.9.0"
  },
  "license": "GPL-3.0-or-later",
  "author": "Jason McVetta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmcvetta/release-please-projected-releases-action.git"
  },
  "bugs": {
    "url": "https://github.com/jmcvetta/release-please-projected-releases-action/issues"
  },
  "homepage": "https://github.com/jmcvetta/release-please-projected-releases-action#readme",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
